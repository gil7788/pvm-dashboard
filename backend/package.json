{
  "name": "mongo-express-typescript",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -R public dist/src/public",
    "start": "node ./dist/bin/www",
    "dev": "ts-node bin/www.ts",
    "test": "npx jest",
    "seed": "ts-node src/scripts/seedDatabase.ts",
    "seed:prod": "node dist/src/scripts/seedDatabase.js",
    "migrate": "ts-node src/scripts/migrateToSimplifiedModel.ts"
  },
  "dependencies": {
    "@cspotcode/source-map-support": "^0.8.1",
    "axios": "^1.6.5",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "mongodb": "^6.3.0",
    "mongoose": "^8.16.5",
    "morgan": "~1.9.1",
    "stack-trace": "^1.0.0-pre2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.23.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/mongodb": "^4.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.7",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.14.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
